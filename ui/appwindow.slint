import { Button, LineEdit } from "std-widgets.slint";

component CatppuccinButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <color> base-color: #313244;       // Surface0
    in property <color> hover-color: #45475a;      // Surface1
    in property <color> active-color: #585b70;     // Surface2
    in property <color> text-color: #cdd6f4;       // Text
    in property <length> font-size: 15px;
    callback clicked();

    border-radius: self.height / 2;
    background: touch.pressed ? active-color : (touch.has-hover ? hover-color : base-color);
    animate background { duration: 90ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: root.text-color;
        font-size: root.font-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "Google TV Remote";
    min-width: 360px;
    min-height: 640px;
    preferred-width: 400px;
    preferred-height: 720px;
    background: #1e1e2e; // Catppuccin Mocha Base

    in-out property <string> tv-ip: "192.168.1.12";
    in-out property <string> connection-status: "Disconnected";
    in-out property <color> status-color: #f38ba8; // Catppuccin Red
    in-out property <string> active-app: "";
    in-out property <bool> show-pairing-modal: false;
    in-out property <string> pairing-pin: "";

    callback send_key(string);
    callback connect_tv(string);
    callback submit_pin(string);
    callback cancel_pairing();
    callback launch_mini_screen();

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (root.show-pairing-modal) {
                return reject;
            }
            if (event.text == Key.UpArrow) { root.send_key("DPAD_UP"); return accept; }
            if (event.text == Key.DownArrow) { root.send_key("DPAD_DOWN"); return accept; }
            if (event.text == Key.LeftArrow) { root.send_key("DPAD_LEFT"); return accept; }
            if (event.text == Key.RightArrow) { root.send_key("DPAD_RIGHT"); return accept; }
            if (event.text == Key.Return || event.text == " ") { root.send_key("DPAD_CENTER"); return accept; }
            if (event.text == Key.Escape || event.text == Key.Backspace) { root.send_key("BACK"); return accept; }
            if (event.text == "h" || event.text == "H" || event.text == Key.Home) { root.send_key("HOME"); return accept; }
            if (event.text == "+" || event.text == "=" || event.text == "]") { root.send_key("VOLUME_UP"); return accept; }
            if (event.text == "-" || event.text == "[") { root.send_key("VOLUME_DOWN"); return accept; }
            if (event.text == "m" || event.text == "M") { root.send_key("MUTE"); return accept; }
            if (event.text == "p" || event.text == "P") { root.send_key("POWER"); return accept; }
            if (event.text == "k" || event.text == "K") { root.send_key("PLAY_PAUSE"); return accept; }
            reject
        }

        // Center content cleanly on screen even when window is maximized
        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                width: 360px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 12px;
                alignment: start;

                // 1. Pixel-Perfect IP Connection Row
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    // IP Input Container with vertically centered status dot
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        background: #11111b; // Crust
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #313244; // Surface0

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 8px;
                            alignment: center;

                            // Status Indicator Dot (Vertically Centered)
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.status-color;
                            }

                            ip-input := LineEdit {
                                text <=> root.tv-ip;
                                placeholder-text: "192.168.1.12";
                                horizontal-stretch: 1;
                                font-size: 13px;
                                accepted => { root.connect_tv(root.tv-ip); }
                            }
                        }
                    }

                    // Matching 38px Height Mauve Connect Button
                    Rectangle {
                        width: 84px;
                        height: 38px;
                        border-radius: 8px;
                        background: btn-connect.pressed ? #b4befe : (btn-connect.has-hover ? #d5b8ff : #cba6f7); // Mauve
                        animate background { duration: 90ms; }

                        btn-connect := TouchArea {
                            clicked => { root.connect_tv(root.tv-ip); }
                        }

                        Text {
                            text: "Connect";
                            color: #11111b; // Crust (contrast > 8:1)
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // 2. HUD Status & Mini Screen Row
                Rectangle {
                    height: 44px;
                    background: #181825; // Mantle
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #313244; // Surface0

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: root.connection-status;
                                color: root.status-color;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            if root.active-app != "": Text {
                                text: "App: " + root.active-app;
                                color: #a6adc8; // Subtext0
                                font-size: 10px;
                                overflow: elide;
                            }
                        }

                        // Lavender Mini Screen Button
                        Rectangle {
                            width: 114px;
                            height: 30px;
                            border-radius: 8px;
                            background: btn-mini.pressed ? #313244 : (btn-mini.has-hover ? #252536 : #181825);
                            border-width: 1px;
                            border-color: #b4befe; // Lavender
                            animate background { duration: 90ms; }

                            btn-mini := TouchArea {
                                clicked => { root.launch_mini_screen(); }
                            }

                            Text {
                                text: "📺 Mini Screen";
                                color: #b4befe; // Lavender
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 3. Top Utility Buttons (Power, Settings, Menu)
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    // Power Button (Catppuccin Red)
                    CatppuccinButton {
                        width: 54px;
                        height: 54px;
                        text: "⏻";
                        font-size: 20px;
                        base-color: #312028;
                        hover-color: #452834;
                        active-color: #5c3244;
                        text-color: #f38ba8; // Red
                        clicked => { root.send_key("POWER"); }
                    }

                    // Settings Button (Catppuccin Peach)
                    CatppuccinButton {
                        width: 54px;
                        height: 54px;
                        text: "⚙";
                        font-size: 20px;
                        text-color: #fab387; // Peach
                        clicked => { root.send_key("SETTINGS"); }
                    }

                    // Menu Button (Catppuccin Sky)
                    CatppuccinButton {
                        width: 54px;
                        height: 54px;
                        text: "☰";
                        font-size: 20px;
                        text-color: #89dceb; // Sky
                        clicked => { root.send_key("MENU"); }
                    }
                }

                // 4. D-Pad Controller Wheel
                Rectangle {
                    height: 220px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 216px;
                            height: 216px;
                            border-radius: 108px;
                            background: #181825; // Mantle
                            border-width: 2px;
                            border-color: #313244; // Surface0

                            // UP
                            CatppuccinButton {
                                x: 78px;
                                y: 8px;
                                width: 60px;
                                height: 50px;
                                text: "▲";
                                font-size: 16px;
                                base-color: transparent;
                                hover-color: #313244;
                                active-color: #45475a;
                                text-color: #cdd6f4;
                                clicked => { root.send_key("DPAD_UP"); }
                            }

                            // DOWN
                            CatppuccinButton {
                                x: 78px;
                                y: 158px;
                                width: 60px;
                                height: 50px;
                                text: "▼";
                                font-size: 16px;
                                base-color: transparent;
                                hover-color: #313244;
                                active-color: #45475a;
                                text-color: #cdd6f4;
                                clicked => { root.send_key("DPAD_DOWN"); }
                            }

                            // LEFT
                            CatppuccinButton {
                                x: 8px;
                                y: 78px;
                                width: 50px;
                                height: 60px;
                                text: "◀";
                                font-size: 16px;
                                base-color: transparent;
                                hover-color: #313244;
                                active-color: #45475a;
                                text-color: #cdd6f4;
                                clicked => { root.send_key("DPAD_LEFT"); }
                            }

                            // RIGHT
                            CatppuccinButton {
                                x: 158px;
                                y: 78px;
                                width: 50px;
                                height: 60px;
                                text: "▶";
                                font-size: 16px;
                                base-color: transparent;
                                hover-color: #313244;
                                active-color: #45475a;
                                text-color: #cdd6f4;
                                clicked => { root.send_key("DPAD_RIGHT"); }
                            }

                            // CENTER (OK)
                            CatppuccinButton {
                                x: 68px;
                                y: 68px;
                                width: 80px;
                                height: 80px;
                                text: "OK";
                                font-size: 17px;
                                base-color: #313244;
                                hover-color: #45475a;
                                active-color: #585b70;
                                text-color: #cba6f7; // Mauve
                                clicked => { root.send_key("DPAD_CENTER"); }
                            }
                        }
                    }
                }

                // 5. Navigation Row (Back, Home, Play/Pause)
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    CatppuccinButton {
                        width: 58px;
                        height: 52px;
                        text: "←";
                        font-size: 22px;
                        clicked => { root.send_key("BACK"); }
                    }

                    CatppuccinButton {
                        width: 58px;
                        height: 52px;
                        text: "⌂";
                        font-size: 22px;
                        text-color: #89b4fa; // Blue
                        clicked => { root.send_key("HOME"); }
                    }

                    CatppuccinButton {
                        width: 58px;
                        height: 52px;
                        text: "⏯";
                        font-size: 18px;
                        text-color: #a6e3a1; // Green
                        clicked => { root.send_key("PLAY_PAUSE"); }
                    }
                }

                // 6. Volume Controls Row
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    CatppuccinButton {
                        width: 58px;
                        height: 52px;
                        text: "–";
                        font-size: 24px;
                        clicked => { root.send_key("VOLUME_DOWN"); }
                    }

                    CatppuccinButton {
                        width: 58px;
                        height: 52px;
                        text: "🔇";
                        font-size: 18px;
                        text-color: #f38ba8; // Red
                        clicked => { root.send_key("MUTE"); }
                    }

                    CatppuccinButton {
                        width: 58px;
                        height: 52px;
                        text: "+";
                        font-size: 24px;
                        clicked => { root.send_key("VOLUME_UP"); }
                    }
                }

                // 7. Clean Keyboard Shortcuts Footnote
                Rectangle {
                    height: 28px;
                    background: #11111b; // Crust
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #313244; // Surface0

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;

                        Text {
                            text: "⌨ Shortcuts: Arrows • Enter/Space • Esc • H • +/-";
                            color: #a6adc8; // Subtext0
                            font-size: 10px;
                            font-weight: 500;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Modal Pairing Dialog
    if root.show-pairing-modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #11111be0; // Crust overlay

        Rectangle {
            width: 300px;
            height: 210px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #181825; // Mantle
            border-radius: 16px;
            border-width: 1px;
            border-color: #cba6f7; // Mauve

            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: "Pairing Required";
                    font-size: 16px;
                    font-weight: 700;
                    color: #cdd6f4;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Enter 6-character PIN shown on your TV:";
                    font-size: 12px;
                    color: #a6adc8;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                pin-field := LineEdit {
                    text <=> root.pairing-pin;
                    placeholder-text: "e.g. 4F2A19";
                    horizontal-alignment: center;
                    font-size: 16px;
                    accepted => { root.submit_pin(root.pairing-pin); }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    CatppuccinButton {
                        width: 86px;
                        height: 38px;
                        text: "Cancel";
                        base-color: #313244;
                        clicked => { root.cancel_pairing(); }
                    }

                    // Mauve Pair Button
                    Rectangle {
                        width: 86px;
                        height: 38px;
                        border-radius: 19px;
                        background: btn-pair.pressed ? #b4befe : (btn-pair.has-hover ? #d5b8ff : #cba6f7);
                        animate background { duration: 90ms; }

                        btn-pair := TouchArea {
                            clicked => { root.submit_pin(root.pairing-pin); }
                        }

                        Text {
                            text: "Pair";
                            color: #11111b; // Crust
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
