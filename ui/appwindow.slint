import { Button, LineEdit } from "std-widgets.slint";

component RemoteButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <color> base-color: #262630;
    in property <color> hover-color: #353544;
    in property <color> active-color: #48485c;
    in property <color> text-color: #f2f2f8;
    in property <length> font-size: 15px;
    callback clicked();

    border-radius: self.height / 2;
    background: touch.pressed ? active-color : (touch.has-hover ? hover-color : base-color);
    animate background { duration: 100ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: root.text-color;
        font-size: root.font-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "Google TV Remote";
    min-width: 360px;
    min-height: 640px;
    preferred-width: 390px;
    preferred-height: 710px;
    background: #121216;

    in-out property <string> tv-ip: "192.168.1.12";
    in-out property <string> connection-status: "Disconnected";
    in-out property <color> status-color: #ff5252;
    in-out property <string> active-app: "";
    in-out property <bool> show-pairing-modal: false;
    in-out property <string> pairing-pin: "";

    callback send_key(string);
    callback connect_tv(string);
    callback submit_pin(string);
    callback cancel_pairing();
    callback launch_mini_screen();

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (root.show-pairing-modal) {
                return reject;
            }
            if (event.text == Key.UpArrow) { root.send_key("DPAD_UP"); return accept; }
            if (event.text == Key.DownArrow) { root.send_key("DPAD_DOWN"); return accept; }
            if (event.text == Key.LeftArrow) { root.send_key("DPAD_LEFT"); return accept; }
            if (event.text == Key.RightArrow) { root.send_key("DPAD_RIGHT"); return accept; }
            if (event.text == Key.Return || event.text == " ") { root.send_key("DPAD_CENTER"); return accept; }
            if (event.text == Key.Escape || event.text == Key.Backspace) { root.send_key("BACK"); return accept; }
            if (event.text == "h" || event.text == "H" || event.text == Key.Home) { root.send_key("HOME"); return accept; }
            if (event.text == "+" || event.text == "=" || event.text == "]") { root.send_key("VOLUME_UP"); return accept; }
            if (event.text == "-" || event.text == "[") { root.send_key("VOLUME_DOWN"); return accept; }
            if (event.text == "m" || event.text == "M") { root.send_key("MUTE"); return accept; }
            if (event.text == "p" || event.text == "P") { root.send_key("POWER"); return accept; }
            if (event.text == "k" || event.text == "K") { root.send_key("PLAY_PAUSE"); return accept; }
            reject
        }

        // Center content even if user maximizes window to widescreen
        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                width: 360px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 12px;
                alignment: start;

                // 1. Unified IP Connection Bar
                Rectangle {
                    height: 52px;
                    background: #1c1c24;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2e2e3e;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.status-color;
                        }

                        ip-input := LineEdit {
                            text <=> root.tv-ip;
                            placeholder-text: "192.168.1.12";
                            horizontal-stretch: 1;
                            font-size: 13px;
                            accepted => { root.connect_tv(root.tv-ip); }
                        }

                        Rectangle {
                            width: 78px;
                            height: 36px;
                            border-radius: 8px;
                            background: btn-connect.pressed ? #283593 : (btn-connect.has-hover ? #3949ab : #304ffe);
                            animate background { duration: 100ms; }

                            btn-connect := TouchArea {
                                clicked => { root.connect_tv(root.tv-ip); }
                            }

                            Text {
                                text: "Connect";
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 2. HUD Status & Mini Screen Row
                Rectangle {
                    height: 44px;
                    background: #181822;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #272738;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: root.connection-status;
                                color: root.status-color;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            if root.active-app != "": Text {
                                text: "App: " + root.active-app;
                                color: #88889e;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            width: 114px;
                            height: 32px;
                            border-radius: 8px;
                            background: btn-mini.pressed ? #1a237e : (btn-mini.has-hover ? #283593 : #212132);
                            border-width: 1px;
                            border-color: #3949ab;
                            animate background { duration: 100ms; }

                            btn-mini := TouchArea {
                                clicked => { root.launch_mini_screen(); }
                            }

                            Text {
                                text: "📺 Mini Screen";
                                color: #82b1ff;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 3. Top Utility Buttons (Power, Settings, Menu)
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    RemoteButton {
                        width: 54px;
                        height: 54px;
                        text: "⏻";
                        font-size: 20px;
                        base-color: #3a181e;
                        hover-color: #4a1f26;
                        active-color: #5c242e;
                        text-color: #ff5252;
                        clicked => { root.send_key("POWER"); }
                    }

                    RemoteButton {
                        width: 54px;
                        height: 54px;
                        text: "⚙";
                        font-size: 20px;
                        clicked => { root.send_key("SETTINGS"); }
                    }

                    RemoteButton {
                        width: 54px;
                        height: 54px;
                        text: "☰";
                        font-size: 20px;
                        clicked => { root.send_key("MENU"); }
                    }
                }

                // 4. D-Pad Controller Wheel
                Rectangle {
                    height: 220px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 216px;
                            height: 216px;
                            border-radius: 108px;
                            background: #1e1e28;
                            border-width: 2px;
                            border-color: #2d2d3c;

                            // UP
                            RemoteButton {
                                x: 78px;
                                y: 8px;
                                width: 60px;
                                height: 50px;
                                text: "▲";
                                font-size: 16px;
                                base-color: transparent;
                                hover-color: #303040;
                                active-color: #404054;
                                clicked => { root.send_key("DPAD_UP"); }
                            }

                            // DOWN
                            RemoteButton {
                                x: 78px;
                                y: 158px;
                                width: 60px;
                                height: 50px;
                                text: "▼";
                                font-size: 16px;
                                base-color: transparent;
                                hover-color: #303040;
                                active-color: #404054;
                                clicked => { root.send_key("DPAD_DOWN"); }
                            }

                            // LEFT
                            RemoteButton {
                                x: 8px;
                                y: 78px;
                                width: 50px;
                                height: 60px;
                                text: "◀";
                                font-size: 16px;
                                base-color: transparent;
                                hover-color: #303040;
                                active-color: #404054;
                                clicked => { root.send_key("DPAD_LEFT"); }
                            }

                            // RIGHT
                            RemoteButton {
                                x: 158px;
                                y: 78px;
                                width: 50px;
                                height: 60px;
                                text: "▶";
                                font-size: 16px;
                                base-color: transparent;
                                hover-color: #303040;
                                active-color: #404054;
                                clicked => { root.send_key("DPAD_RIGHT"); }
                            }

                            // CENTER (OK)
                            RemoteButton {
                                x: 68px;
                                y: 68px;
                                width: 80px;
                                height: 80px;
                                text: "OK";
                                font-size: 16px;
                                base-color: #2e2e3c;
                                hover-color: #3e3e50;
                                active-color: #505068;
                                clicked => { root.send_key("DPAD_CENTER"); }
                            }
                        }
                    }
                }

                // 5. Navigation Row (Back, Home, Play/Pause)
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    RemoteButton {
                        width: 58px;
                        height: 52px;
                        text: "←";
                        font-size: 22px;
                        clicked => { root.send_key("BACK"); }
                    }

                    RemoteButton {
                        width: 58px;
                        height: 52px;
                        text: "⌂";
                        font-size: 22px;
                        clicked => { root.send_key("HOME"); }
                    }

                    RemoteButton {
                        width: 58px;
                        height: 52px;
                        text: "⏯";
                        font-size: 18px;
                        clicked => { root.send_key("PLAY_PAUSE"); }
                    }
                }

                // 6. Volume Controls Row
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    RemoteButton {
                        width: 58px;
                        height: 52px;
                        text: "–";
                        font-size: 24px;
                        clicked => { root.send_key("VOLUME_DOWN"); }
                    }

                    RemoteButton {
                        width: 58px;
                        height: 52px;
                        text: "🔇";
                        font-size: 18px;
                        clicked => { root.send_key("MUTE"); }
                    }

                    RemoteButton {
                        width: 58px;
                        height: 52px;
                        text: "+";
                        font-size: 24px;
                        clicked => { root.send_key("VOLUME_UP"); }
                    }
                }

                // 7. Clean Keyboard Shortcuts Footnote Card
                Rectangle {
                    height: 28px;
                    background: #161620;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #242432;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;

                        Text {
                            text: "⌨ Shortcuts: Arrows • Enter/Space • Esc • H • +/-";
                            color: #77778c;
                            font-size: 10px;
                            font-weight: 500;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Modal Pairing Dialog
    if root.show-pairing-modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000d0;

        Rectangle {
            width: 300px;
            height: 210px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #202028;
            border-radius: 16px;
            border-width: 1px;
            border-color: #3d5afe;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: "Pairing Required";
                    font-size: 16px;
                    font-weight: 700;
                    color: #ffffff;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Enter 6-character PIN shown on your TV:";
                    font-size: 12px;
                    color: #b0b0bb;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                pin-field := LineEdit {
                    text <=> root.pairing-pin;
                    placeholder-text: "e.g. 4F2A19";
                    horizontal-alignment: center;
                    font-size: 16px;
                    accepted => { root.submit_pin(root.pairing-pin); }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    RemoteButton {
                        width: 86px;
                        height: 38px;
                        text: "Cancel";
                        base-color: #353540;
                        clicked => { root.cancel_pairing(); }
                    }

                    RemoteButton {
                        width: 86px;
                        height: 38px;
                        text: "Pair";
                        base-color: #3d5afe;
                        hover-color: #536dfe;
                        clicked => { root.submit_pin(root.pairing-pin); }
                    }
                }
            }
        }
    }
}
